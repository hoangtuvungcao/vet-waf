#
# Sourced by every script in this directory. Install as
# /etc/vet_waf/cluster.env on BOTH nodes, identical byte for byte — the
# scripts work out which node they are running on by matching a local
# address against the list below, so one file serves both.

# ---------------------------------------------------------------------------
# Nodes
# ---------------------------------------------------------------------------
NODE_A_IP=185.113.223.17
NODE_B_IP=212.64.215.120

NODE_A_NAME=edge-a
NODE_B_NAME=edge-b

# Public hostname both nodes serve.
CLUSTER_DOMAIN=firewall.hidev.dev

# The protected origin. Must never appear in public DNS.
ORIGIN=103.77.246.164:80

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# Public traffic. haproxy owns these when the fronting pattern is used.
PUBLIC_HTTP=80
PUBLIC_HTTPS=443
# Comma-separated form, consumed by waf-firewall.sh.
PUBLIC_PORTS="${PUBLIC_HTTP}, ${PUBLIC_HTTPS}"

# Vet-WAF's own listener. In the fronting pattern Vet-WAF moves off :80 so
# haproxy can bind it; in the direct pattern set this back to 80.
WAF_PORT=8080

# Management ports. These are the ones the firewall restricts to the peer:
# never expose them publicly.
HEALTH_PORT=8081     # health agent that haproxy interrogates
STATS_PORT=8404      # haproxy stats/admin socket over HTTP
SSH_PORT=22          # administrative SSH
SYNC_SSH_PORT=$SSH_PORT   # transport for config sync

# Additional admin sources allowed to reach SSH, beyond the peer node.
# Space separated, e.g. ADMIN_IPS="203.0.113.9 198.51.100.4".
# Leave empty to allow the peer only — but make sure you can still reach the
# box some other way (console) before applying.
ADMIN_IPS=""

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
WAF_SRC=/usr/src/vet_waf
WAF_CFG_DIR=/etc/vet_waf
# Everything under this directory is replicated between nodes and must stay
# byte-identical. Anything node-specific (certs, listen addresses) belongs in
# vet_waf.conf, NOT here.
WAF_SHARED_DIR=/etc/vet_waf/cluster

# Centralised logging. Point at whichever node collects, or an external host.
LOG_COLLECTOR_IP=${LOG_COLLECTOR_IP:-$NODE_A_IP}
LOG_COLLECTOR_PORT=${LOG_COLLECTOR_PORT:-6514}

# ---------------------------------------------------------------------------
# Identify which node we are, and who the peer is.
# ---------------------------------------------------------------------------
cluster_identify()
{
	local addrs
	addrs=$(ip -o addr show scope global 2>/dev/null \
		| awk '{split($4,a,"/"); print a[1]}')

	if echo "$addrs" | grep -qx "$NODE_A_IP"; then
		SELF_IP=$NODE_A_IP; SELF_NAME=$NODE_A_NAME
		PEER_IP=$NODE_B_IP; PEER_NAME=$NODE_B_NAME
	elif echo "$addrs" | grep -qx "$NODE_B_IP"; then
		SELF_IP=$NODE_B_IP; SELF_NAME=$NODE_B_NAME
		PEER_IP=$NODE_A_IP; PEER_NAME=$NODE_A_NAME
	else
		echo "cluster.env: this host owns none of the configured node" \
		     "addresses ($NODE_A_IP, $NODE_B_IP)." >&2
		echo "Addresses found: $(echo $addrs | tr '\n' ' ')" >&2
		return 1
	fi
	export SELF_IP SELF_NAME PEER_IP PEER_NAME
	return 0
}
